{
  "manifest_version": 3,
  "name": "Flow · Descargas RUS",
  "version": "0.2.0",
  "version_name": "0.2.0 · Captura SITFA",
  "description": "Descarga los XLS de Seguimiento, Búsqueda de litigantes, Informes y Medidas por vencer desde tu Chrome, sin leer cookies ni contraseñas.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://familia.pjud.cl/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Conectar esta pestaña SITFA a Flow",
    "default_icon": {
      "16": "icons/icono16.png",
      "32": "icons/icono32.png",
      "48": "icons/icono48.png"
    }
  },
  "icons": {
    "16": "icons/icono16.png",
    "32": "icons/icono32.png",
    "48": "icons/icono48.png",
    "128": "icons/icono128.png"
  }
}
